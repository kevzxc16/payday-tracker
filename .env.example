# Copy this file to ".env" and fill in real values.
# The app reads these on startup via app/config.py.

# Server
HOST=127.0.0.1
PORT=8000

# Database
DB_PATH=data/payday.db

# Security
# Generate a long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_LIFETIME_DAYS=30

# Email (SMTP) — used for password resets and reminders.
# For Gmail use an App Password (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Payday Tracker
SMTP_FROM_EMAIL=your@email.com
SMTP_USE_TLS=true

# Base URL used in email links
BASE_URL=http://127.0.0.1:8000

# Set to "true" in production
DEBUG=true
